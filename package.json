{
  "name": "imgwand-monorepo",
  "private": true,
  "type": "module",
  "description": "Inspect and surgically remove image metadata (EXIF, XMP, IPTC, ICC, C2PA) from a k9s-style terminal UI or from code",
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspace @hrhv/imgwand && npm run build --workspace @hrhv/imgwand-cli",
    "build:bin": "tsx scripts/build-binaries.ts",
    "install:local": "sh scripts/install-local.sh",
    "uninstall:local": "sh scripts/uninstall-local.sh",
    "version:set": "tsx scripts/set-version.ts",
    "dev": "tsx packages/cli/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "sh scripts/smoke-test.sh node packages/cli/dist/index.js",
    "screenshots": "tsx scripts/screenshots/run.ts",
    "licenses": "tsx scripts/check-licenses.ts"
  },
  "license": "MPL-2.0",
  "author": "Harshit Budhraja",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "fast-check": "^4.10.2",
    "ink-testing-library": "^4.0.0",
    "puppeteer-core": "^25.17.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@contentauth/c2pa-node@0.10.1": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
